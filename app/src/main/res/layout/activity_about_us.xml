<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingBottom="@dimen/bottom_menu_height_64"
    android:background="@color/order_bg"
    android:orientation="vertical"
    tools:context=".ui.account.AboutUsActivity">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="225dp"
        android:paddingTop="@dimen/status_bar_height_37"
        android:background="@mipmap/ic_pro_details_top"
        android:orientation="vertical">

        <include
            android:id="@+id/titleLayout"
            layout="@layout/layout_title" />

        <Space
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>

        <ImageView
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_gravity="center_horizontal"
            android:src="@mipmap/ic_logo_image" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/margin_15"
            android:src="@mipmap/ic_account_app_name" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@mipmap/ic_account_content_bg"
        android:layout_weight="1">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_100"
            android:layout_marginHorizontal="@dimen/margin_15"
            android:gravity="center_horizontal"
            android:lineHeight="@dimen/margin_25"
            android:text="Credit Bridge helps users view and manage revolving credit line information in a clear and simple way.Users can check available credit line details, current usage, billing information, and account status through the app. We focus on clear information, responsible usage, and account security to support a better digital credit line experience."
            android:textColor="#ffffebd3"
            android:textSize="15sp"
            />



    </LinearLayout>

</LinearLayout>