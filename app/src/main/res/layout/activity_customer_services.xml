<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingBottom="@dimen/bottom_menu_height_64"
    android:background="@color/order_bg"
    android:orientation="vertical"
    tools:context=".ui.account.CustomerServicesActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:paddingTop="@dimen/status_bar_height_37"
        android:background="@drawable/shape_details_top_bg"
        android:orientation="vertical">

        <include
            android:id="@+id/titleLayout"
            layout="@layout/layout_title" />

    </LinearLayout>

    <ImageView
        android:layout_width="70dp"
        android:layout_height="@dimen/margin_70"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/margin_40"
        android:src="@mipmap/ic_logo_image" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="@dimen/margin_30"
        android:paddingHorizontal="@dimen/margin_15"
        android:layout_marginHorizontal="@dimen/margin_20"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@mipmap/ic_custom_service_bg">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_3"
            android:scaleType="fitXY"
            android:src="@mipmap/ic_wa_logo"/>

        <TextView
            android:id="@+id/nameTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=""
            android:textColor="#333333"
            android:textSize="@dimen/ts_16"
            />

        <TextView
            android:id="@+id/valueTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text=""
            android:textColor="#333333"
            android:textSize="@dimen/ts_17"
            android:clickable="true"
            />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_30"
        android:layout_marginHorizontal="@dimen/margin_20"
        android:gravity="center_vertical"
        android:background="@mipmap/ic_custom_service_bg">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/margin_15"
            android:lineHeight="@dimen/margin_28"
            android:gravity="center_vertical"
            android:text="        We are committed to providing you with excellent service. If you encounter any problems while using the app, please contact our customer service team via WhatsApp.

\n        Our professional customer service team will diligently help you resolve your issues within hours."
            android:textColor="#351003"
            android:textSize="15sp"
            />

    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"/>

    <TextView
        android:id="@+id/customerServiceTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:includeFontPadding="false"
        android:text="Customer services"
        android:textColor="#FFD29F"
        android:textSize="16sp"
        android:visibility="gone"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_30"
        android:paddingHorizontal="@dimen/margin_15"
        android:gravity="center_horizontal"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/emailTitleTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#FFD29F"
            android:textSize="@dimen/ts_16"
            />

        <TextView
            android:id="@+id/emailTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text=""
            android:textColor="#FFD29F"
            android:textSize="@dimen/ts_16"
            android:clickable="true"
            />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_marginBottom="@dimen/margin_15"/>


</LinearLayout>